# ============================================================================
#  TopChoice Clone — local development environment
#  cp .env.example .env
# ============================================================================

COMPOSE_PROJECT_NAME=topchoice

# ----------------------------------------------------------------- security
# محليًا فقط. في GCP تُحقن من Secret Manager عبر External Secrets Operator.
JWT_SECRET=local-dev-only-change-me-9f2b7c1d4e6a8b0c2d4e6f8a0b2c4d6e
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=topchoice
POSTGRES_PASSWORD=topchoice_local_pw
# قواعد منفصلة لكل خدمة (database-per-service)
POSTGRES_DB_IDENTITY=topchoice_identity
POSTGRES_DB_ORDER=topchoice_order
POSTGRES_DB_PAYMENT=topchoice_payment
POSTGRES_DB_INVENTORY=topchoice_inventory

# ------------------------------------------------------------------- MongoDB
MONGO_URI=mongodb://topchoice:topchoice_local_pw@mongo:27017/topchoice_catalog?authSource=admin
MONGO_INITDB_ROOT_USERNAME=topchoice
MONGO_INITDB_ROOT_PASSWORD=topchoice_local_pw

# --------------------------------------------------------------------- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --------------------------------------------------------------------- Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------------------------------------------------------------- OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=products-v1

# ----------------------------------------------------------------------- GCP
# محليًا نشغّل محاكيات Google الرسمية. في الإنتاج: Workload Identity —
# الـ Pod يستعير هوية Service Account بلا أي مفتاح JSON داخل الصورة.
GOOGLE_CLOUD_PROJECT=topchoice-local
GCP_REGION=me-central1

# Cloud Storage
GCS_MEDIA_BUCKET=topchoice-media-local

# Pub/Sub — النشر على موضوع، والاستهلاك عبر اشتراك مستقل لكل مستهلك:
# إضافة مستهلك جديد لا تمسّ المنتِج ولا تحتاج ربطًا يدويًا.
PUBSUB_NOTIFICATIONS_TOPIC=topchoice-notifications
PUBSUB_NOTIFICATIONS_SUBSCRIPTION=topchoice-notifications-sub
PUBSUB_ORDER_EVENTS_TOPIC=topchoice-order-events
PUBSUB_ANALYTICS_TOPIC=topchoice-analytics

# مضيفو المحاكيات — مكتبات Google العميلة تقرأ هذه الأسماء بنفسها وتتجاوز
# الـ endpoint الحقيقي، فلا يحتاج كود الخدمة إلى مسار «محلي» منفصل.
# اتركها فارغة (أو احذفها) لتتحدث الخدمة مع GCP الحقيقية.
PUBSUB_EMULATOR_HOST=pubsub-emulator:8681
FIRESTORE_EMULATOR_HOST=firestore-emulator:8091
STORAGE_EMULATOR_HOST=http://fake-gcs:4443

# Vertex AI Search for commerce (Retail API)
# فارغة محليًا => يعمل محرك التوصيات الاحتياطي الداخلي
RETAIL_CATALOG=default_catalog
RETAIL_SERVING_CONFIG_USER=
RETAIL_SERVING_CONFIG_RELATED=
RETAIL_SERVING_CONFIG_RANKING=
# مفتاح API لبثّ أحداث المستخدم من المتصفح فقط؛ البثّ من الخادم يمرّ
# عبر Workload Identity ولا يحتاجه.
RETAIL_API_KEY=

# ------------------------------------------------------------------- service
SERVICE_URL_IDENTITY=http://identity-service:8081
SERVICE_URL_CATALOG=http://catalog-service:8082
SERVICE_URL_ORDER=http://order-service:8083
SERVICE_URL_PAYMENT=http://payment-service:8084
SERVICE_URL_INVENTORY=http://inventory-service:8085
SERVICE_URL_CART=http://cart-service:8086
SERVICE_URL_SEARCH=http://search-service:8087
SERVICE_URL_RECOMMENDATION=http://recommendation-service:8088

# ------------------------------------------------------------------ frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_CDN_URL=http://localhost:4443/topchoice-media-local
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ------------------------------------------------------------------- tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=1.0
