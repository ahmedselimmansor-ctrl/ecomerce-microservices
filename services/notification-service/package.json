{
  "name": "@topchoice/notification-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kafka consumer that fans out to SES / SNS / Web Push",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.699.0",
    "@aws-sdk/client-sns": "^3.699.0",
    "fastify": "^5.12.0",
    "kafkajs": "^2.2.4",
    "nodemailer": "^6.9.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
