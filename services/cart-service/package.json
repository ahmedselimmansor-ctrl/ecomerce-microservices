{
  "name": "@topchoice/cart-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shopping cart backed by Redis (Memorystore on Google Cloud)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist-test && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
