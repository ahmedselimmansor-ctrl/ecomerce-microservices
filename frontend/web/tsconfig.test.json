{
  // إعداد منفصل للاختبارات.
  //
  // tsconfig الأساسي مضبوط لـ Next.js: `module: esnext` و
  // `moduleResolution: bundler` — لا يُصدِر شيئًا ويعتمد على المُجمِّع.
  // مُشغّل node:test يحتاج وحدات ES صالحة على القرص بامتدادات صريحة،
  // فنُصدِرها هنا بـ NodeNext إلى مجلد مؤقت.
  //
  // نقتصر على src/lib لأن ما فيه دوال نقية. المنطق الذي كان محبوسًا داخل
  // مكوّنات — كاختيار إشارة البطاقة — نُقل إلى هنا بدل جرّ DOM ومُصيِّر
  // كاملين لفحص سلسلة من `if`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist-test",
    "declaration": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/lib/*.ts"]
}
